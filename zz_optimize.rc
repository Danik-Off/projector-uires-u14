# Custom optimization (added 2026-09-18). To revert: delete this file and reboot.
on property:sys.boot_completed=1
    # Debug/telemetry daemons not needed on a home projector
    stop boa
    stop perfprofd
    stop xiriservice
    # CPU: hold max clock, no ramp-up latency (2-step 800/1000 MHz)
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor performance
    # eMMC: larger readahead for faster app loading
    write /sys/block/mmcblk0/queue/read_ahead_kb 512
    # Background dexopt (runs at idle) recompiles updated apps to full AOT
    setprop pm.dexopt.bg-dexopt speed
